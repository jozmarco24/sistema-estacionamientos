# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=db_sistema_estacionamientos
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL Base de conexión para SQLAlchemy
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/db_sistema_estacionamientos

# Seguridad JWT y Clave Inter-Servicios
JWT_SECRET=reemplazar_con_clave_secreta_jwt_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
INTERNAL_SERVICE_KEY=reemplazar_con_clave_larga_aleatoria_compartida

# Culqi (SOLO MODO PRUEBA: debe iniciar con pk_test_ y sk_test_)
CULQI_PUBLIC_KEY=pk_test_tu_llave_publica_prueba
CULQI_SECRET_KEY=sk_test_tu_llave_secreta_prueba

# Cifrado simétrico Fernet (32 bytes base64) para almacenar sk_test_ de propietarios
ENCRYPTION_KEY=reemplazar_con_fernet_key_generada

# Administrador Inicial
ADMIN_NOMBRE=Admin Global
ADMIN_EMAIL=admin@smartpark.com
ADMIN_PASSWORD=reemplazar_con_password_segura

# URLs para comunicación inter-servicio
ESTACIONAMIENTOS_SERVICE_URL=http://estacionamientos:8002
PAGOS_SERVICE_URL=http://pagos:8004
USUARIOS_SERVICE_URL=http://usuarios:8001
RESERVAS_SERVICE_URL=http://reservas:8003
